{"sections":[],"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective","doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted"],"anchor":"Related-Documentation"},{"title":"Explanation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/Obfuscation"],"anchor":"Explanation","generated":true}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Env-var secret setups have a recurring failure mode: the variable works in your shell but Xcode can’t see it, or it works locally but not in CI, or ","type":"text"},{"type":"codeVoice","code":"~\/.zshenv"},{"text":" exports it fine but ","type":"text"},{"type":"codeVoice","code":"xcodebuild"},{"text":" from a launcher doesn’t pick it up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Tightlip addresses this by sourcing your shell init file itself, in a controlled subshell, every build.","type":"text"}]},{"level":2,"text":"The Algorithm","type":"heading","anchor":"The-Algorithm"},{"type":"paragraph","inlineContent":[{"text":"For each build, the plugin:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sources the env file in a clean zsh subshell."}]},{"text":" By default this is ","type":"text"},{"type":"codeVoice","code":"~\/.zshenv"},{"text":", sourced with ","type":"text"},{"type":"codeVoice","code":"zsh -f"},{"text":" (no startup files, no profile chain). The subshell captures the resulting environment as a snapshot.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Merges that snapshot with "},{"type":"codeVoice","code":"ProcessInfo.processInfo.environment"}],"type":"strong"},{"text":" — the build’s own environment, including Xcode Scheme env vars and CI job env vars.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resolves per-key conflicts in favor of "},{"type":"codeVoice","code":"ProcessInfo"},{"type":"text","text":"."}]},{"type":"text","text":" A CI runner that explicitly exports "},{"type":"codeVoice","code":"APP_API_KEY"},{"type":"text","text":" overrides anything "},{"type":"codeVoice","code":"~\/.zshenv"},{"type":"text","text":" might have said."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The result: identical resolution regardless of how the build was launched. Xcode.app from Finder, Conductor, VS Code, "},{"type":"codeVoice","code":"xcodebuild"},{"type":"text","text":" from Terminal — same env vars seen, same generated file."}]},{"level":2,"text":"Failure Modes","type":"heading","anchor":"Failure-Modes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subshell sourcing has a "},{"inlineContent":[{"type":"text","text":"5-second timeout"}],"type":"strong"},{"type":"text","text":". If sourcing fails (the file doesn’t exist, the file errors out, or it just takes too long), the tool falls back to "},{"type":"codeVoice","code":"ProcessInfo"},{"type":"text","text":" alone and writes a single "},{"type":"codeVoice","code":"note:"},{"type":"text","text":" to stderr identifying the file."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This means CI runners with no "},{"code":"~\/.zshenv","type":"codeVoice"},{"type":"text","text":" work unchanged — the fallback kicks in immediately and the job’s "},{"code":"env:","type":"codeVoice"},{"type":"text","text":" block is the sole source of values."}]},{"level":2,"text":"Slow `.zshenv` Cases","type":"heading","anchor":"Slow-zshenv-Cases"},{"inlineContent":[{"text":"Tools like ","type":"text"},{"code":"mise","type":"codeVoice"},{"text":", ","type":"text"},{"code":"asdf","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"direnv","type":"codeVoice"},{"text":" invoked during ","type":"text"},{"code":".zshenv","type":"codeVoice"},{"text":" can push past the 5-second budget. If you see the ","type":"text"},{"code":"note: sourcing \/path\/to\/file ... using process environment only","type":"codeVoice"},{"text":" message and weren’t expecting it, reproduce with:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["zsh -f -c 'source ~\/.zshenv'"],"syntax":"bash"},{"inlineContent":[{"text":"If that hangs or errors, your shell init is the cause. Move slow tools out of ","type":"text"},{"code":".zshenv","type":"codeVoice"},{"text":" (into ","type":"text"},{"code":".zshrc","type":"codeVoice"},{"text":", which the plugin doesn’t read), or point Tightlip at a smaller sidecar file with the ","type":"text"},{"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective","overridingTitle":"envFile directive","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"envFile directive"}],"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Why your env vars resolve the same way whether you build from Xcode, the terminal, or CI."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tightlipcore\/environmentsourcing"]}],"metadata":{"role":"article","modules":[{"name":"Tightlip"}],"roleHeading":"Article","title":"How Environment Sourcing Works"},"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://TightlipCore/documentation/TightlipCore":{"type":"topic","url":"\/documentation\/tightlipcore","title":"Tightlip","role":"collection","kind":"symbol","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"code":"Secrets","type":"codeVoice"},{"text":" enum from environment variables at build time.","type":"text"}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore"},"doc://TightlipCore/documentation/TightlipCore/GettingStarted":{"kind":"article","type":"topic","title":"Getting Started with Tightlip","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","url":"\/documentation\/tightlipcore\/gettingstarted","abstract":[{"text":"Add the plugin to a target, drop in a ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", and start reading secrets at compile time.","type":"text"}],"role":"article"},"doc://TightlipCore/documentation/TightlipCore/Obfuscation":{"type":"topic","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/Obfuscation","kind":"article","abstract":[{"text":"What the XOR encoding actually protects against, and what it doesn’t.","type":"text"}],"url":"\/documentation\/tightlipcore\/obfuscation","role":"article","title":"Obfuscation and Threat Model"},"doc://TightlipCore/documentation/TightlipCore/EnvFileDirective":{"title":"Overriding the Sourced Env File","abstract":[{"text":"Point Tightlip at a different shell-init file with the ","type":"text"},{"code":"envFile:","type":"codeVoice"},{"text":" directive.","type":"text"}],"type":"topic","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective","role":"article","url":"\/documentation\/tightlipcore\/envfiledirective","kind":"article"}}}