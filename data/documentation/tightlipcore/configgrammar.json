{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection"],"anchor":"Reference","generated":true}],"metadata":{"role":"article","modules":[{"name":"Tightlip"}],"roleHeading":"Article","title":"Config Grammar"},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Tightlip parses a small, strict subset of YAML. The parser rejects anything ambiguous so config errors fail loudly at build time instead of silently emitting the wrong value."}],"type":"paragraph"},{"text":"Rules","level":2,"type":"heading","anchor":"Rules"},{"items":[{"content":[{"inlineContent":[{"text":"Property names and env-var names must be bare ASCII identifiers (","type":"text"},{"code":"[A-Za-z_][A-Za-z0-9_]*","type":"codeVoice"},{"text":"). No quoting.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"#","type":"codeVoice"},{"text":" at the start of a line is a comment. Inline comments after a value are not supported.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Blank lines are fine. Tabs are not — anywhere."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flat mode: no leading whitespace on mapping lines."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sectioned mode: section headers at column 1, content at exactly 2-space indent."}]}]},{"content":[{"inlineContent":[{"text":"Every declared secret is required at build time. If an env var is unset, the build fails with a message pointing at the missing variable. Truly optional values should be read from ","type":"text"},{"type":"codeVoice","code":"ProcessInfo"},{"text":" at runtime rather than declared here.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Duplicate keys, empty files, and anything else outside this grammar are parse errors with a line number."}]}]}],"type":"unorderedList"},{"text":"Format Detection","level":2,"type":"heading","anchor":"Format-Detection"},{"inlineContent":[{"type":"text","text":"The parser auto-detects format from the first non-comment line:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it has the shape "},{"type":"codeVoice","code":"key: value"},{"type":"text","text":", the file is "},{"type":"strong","inlineContent":[{"text":"flat","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it has the shape "},{"type":"codeVoice","code":"name:"},{"type":"text","text":" (no value), the file is "},{"type":"strong","inlineContent":[{"type":"text","text":"sectioned"}]},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A single file cannot mix the two.","type":"text"}],"type":"paragraph"},{"text":"Error Messages","level":2,"type":"heading","anchor":"Error-Messages"},{"inlineContent":[{"type":"text","text":"Parse errors print as "},{"code":"<path>:<line>: <reason>","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["error: Secrets.yml:1: tab character not allowed; use spaces","error: Secrets.yml:1: expected '<name>: <ENV_VAR>', got 'foo BAR'","error: Secrets.yml:3: duplicate key 'foo' (first defined on line 1)","error: Secrets.yml: no secrets declared"]},{"inlineContent":[{"type":"text","text":"The line number is omitted for whole-file errors like an empty config."}],"type":"paragraph"},{"text":"Common Pitfalls","level":2,"type":"heading","anchor":"Common-Pitfalls"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Tabs from a paste:","type":"text"}]},{"type":"text","text":" “expected ‘"},{"type":"text","text":": <ENV_VAR>’” usually means an invisible tab. Re-type the line."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Quoted values:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"foo: \"BAR\"","type":"codeVoice"},{"text":" fails — quotes aren’t accepted.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Inline comments:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"foo: BAR # comment","type":"codeVoice"},{"type":"text","text":" fails — comments are line-level only."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Hyphenated identifiers:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"revenue-cat-key: ..."},{"type":"text","text":" fails — use camelCase Swift identifiers."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/tightlipcore\/configgrammar"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"The accepted shape of ","type":"text"},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":", line by line."}],"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"references":{"doc://TightlipCore/documentation/TightlipCore":{"title":"Tightlip","type":"topic","kind":"symbol","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore","url":"\/documentation\/tightlipcore","role":"collection","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"type":"codeVoice","code":"Secrets"},{"text":" enum from environment variables at build time.","type":"text"}]},"doc://TightlipCore/documentation/TightlipCore/GettingStarted":{"kind":"article","role":"article","url":"\/documentation\/tightlipcore\/gettingstarted","title":"Getting Started with Tightlip","abstract":[{"type":"text","text":"Add the plugin to a target, drop in a "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":", and start reading secrets at compile time."}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","type":"topic"},"doc://TightlipCore/documentation/TightlipCore/SectionedConfigs":{"title":"Multi-Environment Configs","kind":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","abstract":[{"type":"text","text":"Declare staging and production secrets in one file and select between them per build."}],"role":"article","url":"\/documentation\/tightlipcore\/sectionedconfigs","type":"topic"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSelection":{"abstract":[{"type":"text","text":"How Tightlip picks the active section for a sectioned config."}],"url":"\/documentation\/tightlipcore\/environmentselection","title":"Environment Selection","kind":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","role":"article","type":"topic"}}}