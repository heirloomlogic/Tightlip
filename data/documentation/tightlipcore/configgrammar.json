{"abstract":[{"text":"The accepted shape of ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", line by line.","type":"text"}],"variants":[{"paths":["\/documentation\/tightlipcore\/configgrammar"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar"},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs"]},{"generated":true,"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tightlip parses a small, strict subset of YAML. The parser rejects anything ambiguous so config errors fail loudly at build time instead of silently emitting the wrong value."}]},{"anchor":"Rules","type":"heading","text":"Rules","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Property names and env-var names must be bare ASCII identifiers ("},{"code":"[A-Za-z_][A-Za-z0-9_]*","type":"codeVoice"},{"type":"text","text":"). No quoting."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"#","type":"codeVoice"},{"text":" at the start of a line is a comment. Inline comments after a value are not supported.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Blank lines are fine. Tabs are not — anywhere.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Flat mode: no leading whitespace on mapping lines."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sectioned mode: section headers at column 1, content at exactly 2-space indent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every declared secret is required at build time. If an env var is unset, the build fails with a message pointing at the missing variable. Truly optional values should be read from "},{"type":"codeVoice","code":"ProcessInfo"},{"type":"text","text":" at runtime rather than declared here."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Duplicate keys, empty files, and anything else outside this grammar are parse errors with a line number."}]}]}]},{"anchor":"Format-Detection","type":"heading","text":"Format Detection","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parser auto-detects format from the first non-comment line:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"If it has the shape ","type":"text"},{"code":"key: value","type":"codeVoice"},{"text":", the file is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"flat"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it has the shape "},{"type":"codeVoice","code":"name:"},{"type":"text","text":" (no value), the file is "},{"type":"strong","inlineContent":[{"type":"text","text":"sectioned"}]},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single file cannot mix the two."}]},{"anchor":"Error-Messages","type":"heading","text":"Error Messages","level":2},{"type":"paragraph","inlineContent":[{"text":"Parse errors print as ","type":"text"},{"code":"<path>:<line>: <reason>","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["error: Secrets.yml:1: tab character not allowed; use spaces","error: Secrets.yml:1: expected '<name>: <ENV_VAR>', got 'foo BAR'","error: Secrets.yml:3: duplicate key 'foo' (first defined on line 1)","error: Secrets.yml: no secrets declared"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"The line number is omitted for whole-file errors like an empty config."}]},{"anchor":"Common-Pitfalls","type":"heading","text":"Common Pitfalls","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Tabs from a paste:","type":"text"}],"type":"strong"},{"text":" “expected ‘","type":"text"},{"text":": <ENV_VAR>’” usually means an invisible tab. Re-type the line.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Quoted values:"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"foo: \"BAR\""},{"text":" fails — quotes aren’t accepted.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Inline comments:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"foo: BAR # comment"},{"type":"text","text":" fails — comments are line-level only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Hyphenated identifiers:","type":"text"}]},{"text":" ","type":"text"},{"code":"revenue-cat-key: ...","type":"codeVoice"},{"text":" fails — use camelCase Swift identifiers.","type":"text"}],"type":"paragraph"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Tightlip"}],"role":"article","title":"Config Grammar"},"references":{"doc://TightlipCore/documentation/TightlipCore/GettingStarted":{"kind":"article","abstract":[{"type":"text","text":"Add the plugin to a target, drop in a "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":", and start reading secrets at compile time."}],"type":"topic","url":"\/documentation\/tightlipcore\/gettingstarted","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","title":"Getting Started with Tightlip"},"doc://TightlipCore/documentation/TightlipCore/SectionedConfigs":{"abstract":[{"type":"text","text":"Declare staging and production secrets in one file and select between them per build."}],"type":"topic","title":"Multi-Environment Configs","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","url":"\/documentation\/tightlipcore\/sectionedconfigs"},"doc://TightlipCore/documentation/TightlipCore":{"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"code":"Secrets","type":"codeVoice"},{"text":" enum from environment variables at build time.","type":"text"}],"url":"\/documentation\/tightlipcore","type":"topic","role":"collection","title":"Tightlip","kind":"symbol"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSelection":{"role":"article","type":"topic","url":"\/documentation\/tightlipcore\/environmentselection","title":"Environment Selection","abstract":[{"type":"text","text":"How Tightlip picks the active section for a sectioned config."}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","kind":"article"}}}