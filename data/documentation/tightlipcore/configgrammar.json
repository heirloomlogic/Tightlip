{"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"Tightlip parses a small, strict subset of YAML. The parser rejects anything ambiguous so config errors fail loudly at build time instead of silently emitting the wrong value.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Rules","anchor":"Rules"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property names and env-var names must be bare ASCII identifiers ("},{"code":"[A-Za-z_][A-Za-z0-9_]*","type":"codeVoice"},{"type":"text","text":"). No quoting."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"#"},{"type":"text","text":" at the start of a line is a comment. Inline comments after a value are not supported."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Blank lines are fine. Tabs are not — anywhere."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Flat mode: no leading whitespace on mapping lines."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Sectioned mode: section headers at column 1, content at exactly 2-space indent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Every declared secret is required at build time. If an env var is unset, the build fails with a message pointing at the missing variable. Truly optional values should be read from ","type":"text"},{"code":"ProcessInfo","type":"codeVoice"},{"text":" at runtime rather than declared here.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Duplicate keys, empty files, and anything else outside this grammar are parse errors with a line number."}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Format Detection","anchor":"Format-Detection"},{"inlineContent":[{"text":"The parser auto-detects format from the first non-comment line:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it has the shape "},{"code":"key: value","type":"codeVoice"},{"type":"text","text":", the file is "},{"inlineContent":[{"text":"flat","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If it has the shape "},{"type":"codeVoice","code":"name:"},{"type":"text","text":" (no value), the file is "},{"type":"strong","inlineContent":[{"type":"text","text":"sectioned"}]},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"A single file cannot mix the two.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Error Messages","anchor":"Error-Messages"},{"inlineContent":[{"text":"Parse errors print as ","type":"text"},{"code":"<path>:<line>: <reason>","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["error: Secrets.yml:1: tab character not allowed; use spaces","error: Secrets.yml:1: expected '<name>: <ENV_VAR>', got 'foo BAR'","error: Secrets.yml:3: duplicate key 'foo' (first defined on line 1)","error: Secrets.yml: no secrets declared"],"syntax":null},{"inlineContent":[{"text":"The line number is omitted for whole-file errors like an empty config.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Common Pitfalls","anchor":"Common-Pitfalls"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Tabs from a paste:","type":"text"}],"type":"strong"},{"text":" “expected ‘","type":"text"},{"text":": <ENV_VAR>’” usually means an invisible tab. Re-type the line.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Quoted values:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"foo: \"BAR\"","type":"codeVoice"},{"text":" fails — quotes aren’t accepted.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Inline comments:"}]},{"type":"text","text":" "},{"code":"foo: BAR # comment","type":"codeVoice"},{"type":"text","text":" fails — comments are line-level only."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Hyphenated identifiers:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"revenue-cat-key: ..."},{"type":"text","text":" fails — use camelCase Swift identifiers."}]}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tightlipcore\/configgrammar"]}],"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs"]},{"generated":true,"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection"]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Tightlip"}],"title":"Config Grammar"},"abstract":[{"type":"text","text":"The accepted shape of "},{"code":"Secrets.yml","type":"codeVoice"},{"type":"text","text":", line by line."}],"references":{"doc://TightlipCore/documentation/TightlipCore":{"type":"topic","url":"\/documentation\/tightlipcore","title":"Tightlip","role":"collection","kind":"symbol","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"code":"Secrets","type":"codeVoice"},{"text":" enum from environment variables at build time.","type":"text"}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSelection":{"type":"topic","url":"\/documentation\/tightlipcore\/environmentselection","kind":"article","title":"Environment Selection","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","role":"article","abstract":[{"text":"How Tightlip picks the active section for a sectioned config.","type":"text"}]},"doc://TightlipCore/documentation/TightlipCore/GettingStarted":{"kind":"article","type":"topic","title":"Getting Started with Tightlip","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","url":"\/documentation\/tightlipcore\/gettingstarted","abstract":[{"text":"Add the plugin to a target, drop in a ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", and start reading secrets at compile time.","type":"text"}],"role":"article"},"doc://TightlipCore/documentation/TightlipCore/SectionedConfigs":{"role":"article","title":"Multi-Environment Configs","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","kind":"article","abstract":[{"text":"Declare staging and production secrets in one file and select between them per build.","type":"text"}],"url":"\/documentation\/tightlipcore\/sectionedconfigs","type":"topic"}}}