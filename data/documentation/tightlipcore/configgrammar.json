{"metadata":{"roleHeading":"Article","role":"article","title":"Config Grammar","modules":[{"name":"Tightlip"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection"],"title":"Reference","generated":true,"anchor":"Reference"}],"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Tightlip parses a small, strict subset of YAML. The parser rejects anything ambiguous so config errors fail loudly at build time instead of silently emitting the wrong value.","type":"text"}]},{"anchor":"Rules","text":"Rules","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Property names and env-var names must be bare ASCII identifiers ("},{"type":"codeVoice","code":"[A-Za-z_][A-Za-z0-9_]*"},{"type":"text","text":"). No quoting."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"#","type":"codeVoice"},{"text":" at the start of a line is a comment. Inline comments after a value are not supported.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Blank lines are fine. Tabs are not — anywhere."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Flat mode: no leading whitespace on mapping lines.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Sectioned mode: section headers at column 1, content at exactly 2-space indent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Every declared secret is required at build time. If an env var is unset, the build fails with a message pointing at the missing variable. Truly optional values should be read from ","type":"text"},{"code":"ProcessInfo","type":"codeVoice"},{"text":" at runtime rather than declared here.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Duplicate keys, empty files, and anything else outside this grammar are parse errors with a line number.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Format Detection","anchor":"Format-Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parser auto-detects format from the first non-comment line:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"If it has the shape "},{"type":"codeVoice","code":"key: value"},{"type":"text","text":", the file is "},{"type":"strong","inlineContent":[{"text":"flat","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If it has the shape "},{"type":"codeVoice","code":"name:"},{"type":"text","text":" (no value), the file is "},{"type":"strong","inlineContent":[{"type":"text","text":"sectioned"}]},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A single file cannot mix the two.","type":"text"}]},{"type":"heading","level":2,"text":"Error Messages","anchor":"Error-Messages"},{"type":"paragraph","inlineContent":[{"text":"Parse errors print as ","type":"text"},{"code":"<path>:<line>: <reason>","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":null,"code":["error: Secrets.yml:1: tab character not allowed; use spaces","error: Secrets.yml:1: expected '<name>: <ENV_VAR>', got 'foo BAR'","error: Secrets.yml:3: duplicate key 'foo' (first defined on line 1)","error: Secrets.yml: no secrets declared"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The line number is omitted for whole-file errors like an empty config."}]},{"type":"heading","level":2,"text":"Common Pitfalls","anchor":"Common-Pitfalls"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Tabs from a paste:","type":"text"}],"type":"strong"},{"type":"text","text":" “expected ‘"},{"type":"text","text":": <ENV_VAR>’” usually means an invisible tab. Re-type the line."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Quoted values:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"foo: \"BAR\""},{"type":"text","text":" fails — quotes aren’t accepted."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Inline comments:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"foo: BAR # comment"},{"type":"text","text":" fails — comments are line-level only."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Hyphenated identifiers:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"revenue-cat-key: ...","type":"codeVoice"},{"text":" fails — use camelCase Swift identifiers.","type":"text"}],"type":"paragraph"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tightlipcore\/configgrammar"]}],"abstract":[{"type":"text","text":"The accepted shape of "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":", line by line."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","sections":[],"identifier":{"url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","interfaceLanguage":"swift"},"references":{"doc://TightlipCore/documentation/TightlipCore/EnvironmentSelection":{"url":"\/documentation\/tightlipcore\/environmentselection","title":"Environment Selection","kind":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","abstract":[{"text":"How Tightlip picks the active section for a sectioned 