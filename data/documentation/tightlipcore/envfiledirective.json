{"seeAlsoSections":[{"identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ContinuousIntegration","doc:\/\/TightlipCore\/documentation\/TightlipCore\/Troubleshooting"],"generated":true,"anchor":"How-To-Guides","title":"How-To Guides"}],"metadata":{"roleHeading":"Article","modules":[{"name":"Tightlip"}],"title":"Overriding the Sourced Env File","role":"article"},"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the build tool sources "},{"type":"codeVoice","code":"~\/.zshenv"},{"type":"text","text":" to pick up your shell-exported env vars. If your shell isn’t zsh, or your env-var exports live elsewhere, declare an "},{"type":"codeVoice","code":"envFile:"},{"type":"text","text":" directive at the top of "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The directive must be the "},{"type":"strong","inlineContent":[{"text":"first","type":"text"}]},{"type":"text","text":" non-blank, non-comment line. Anything after a section header or property mapping is parsed as a secret declaration and will fail."}]},{"level":2,"type":"heading","text":"Syntax","anchor":"Syntax"},{"syntax":"yaml","type":"codeListing","code":["envFile: ~\/.bash_profile","revenueCatAPIKey: REVENUECAT_API_KEY"]},{"type":"paragraph","inlineContent":[{"text":"The path is tilde-expanded against ","type":"text"},{"code":"$HOME","type":"codeVoice"},{"text":"; relative paths resolve against the config’s directory.","type":"text"}]},{"level":2,"type":"heading","text":"Per-Shell Recommendations","anchor":"Per-Shell-Recommendations"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Shell","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Recommended path","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Notes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"zsh"}]}],[{"type":"paragraph","inlineContent":[{"code":"~\/.zshenv","type":"codeVoice"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"(default — directive can be omitted)"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sourced cleanly with "},{"type":"codeVoice","code":"zsh -f"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"bash"}]}],[{"type":"paragraph","inlineContent":[{"code":"~\/.bash_profile","type":"codeVoice"},{"type":"text","text":" or "},{"code":"~\/.bashrc","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sourced by zsh; shell-compatible "},{"code":"export","type":"codeVoice"},{"type":"text","text":" syntax works"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"fish"}]}],[{"type":"paragraph","inlineContent":[{"code":"~\/.config\/tightlip.env","type":"codeVoice"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"(sidecar)"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fish syntax isn’t zsh-compatible; keep a file of "},{"type":"codeVoice","code":"export KEY=value"},{"type":"text","text":" lines"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"nushell \/ xonsh \/ etc.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"~\/.tightlip.env","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"text":"(sidecar)","type":"text"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"Same sidecar pattern as fish","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"CI runners typically have no "},{"code":".zshenv","type":"codeVoice"},{"type":"text","text":"; the tool falls back to "},{"code":"ProcessInfo","type":"codeVoice"},{"type":"text","text":" and the job’s "},{"code":"env:","type":"codeVoice"},{"type":"text","text":" block works unchanged."}]},{"level":2,"type":"heading","text":"Project-Local Env File","anchor":"Project-Local-Env-File"},{"type":"paragraph","inlineContent":[{"text":"To keep a secrets file inside the project rather than your home directory, point the directive at a sibling of ","type":"text"},{"type":"codeVoice","code":"Secrets.yml"},{"text":" — relative ","type":"text"},{"type":"codeVoice","code":"envFile:"},{"text":" paths resolve against the config’s directory:","type":"text"}]},{"code":["# Sources\/MyApp\/Secrets.yml","envFile: secrets.env","revenueCatAPIKey: ACME_REVENUECAT_API_KEY"],"syntax":"yaml","type":"codeListing"},{"code":["# Sources\/MyApp\/secrets.env","export ACME_REVENUECAT_API_KEY=\"...\""],"syntax":"sh","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The file is sourced in the same "},{"type":"codeVoice","code":"zsh -f"},{"type":"text","text":" subshell, so it must use "},{"type":"codeVoice","code":"export KEY=value"},{"type":"text","text":" syntax — not bare "},{"type":"codeVoice","code":"KEY=value"},{"type":"text","text":" dotenv lines."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Gitignore it.","type":"text"}]},{"type":"text","text":" A secrets file inside the source tree is one "},{"type":"codeVoice","code":"git add"},{"type":"text","text":" away from a committed secret. Add it to "},{"type":"codeVoice","code":".gitignore"},{"type":"text","text":"; only "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":" — the manifest of env-var "},{"type":"emphasis","inlineContent":[{"type":"text","text":"names"}]},{"type":"text","text":" — belongs in source control."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Worktree caveat.","type":"text"}]},{"type":"text","text":" A project-local file lives inside each checkout, so every git worktree (and every fresh clone) needs its own copy. When you build the same project from multiple worktrees — e.g. parallel agents in Conductor — a single "},{"type":"codeVoice","code":"~\/.zshenv"},{"type":"text","text":" is sourced identically by all of them, while a project-local file must be re-created per worktree. Prefer "},{"type":"codeVoice","code":"~\/.zshenv"},{"type":"text","text":" (or a "},{"type":"codeVoice","code":"~"},{"type":"text","text":"-rooted sidecar) when worktree portability matters; use a project-local file only when you specifically want secrets scoped to one checkout."}]},{"anchor":"Why-Theres-No-Dedicated-env-Feature","level":2,"type":"heading","text":"Why There’s No Dedicated `.env` Feature"},{"type":"paragraph","inlineContent":[{"text":"Tightlip deliberately doesn’t auto-discover or parse a ","type":"text"},{"type":"codeVoice","code":".env"},{"text":" file. The recipe above already provides a project-local env file through the existing directive, so a dedicated feature would add only two things, both with costs:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Bare dotenv syntax","type":"text"}]},{"type":"text","text":" ("},{"code":"KEY=value","type":"codeVoice"},{"type":"text","text":" without "},{"code":"export","type":"codeVoice"},{"type":"text","text":") would require parsing values ourselves. Today Tightlip never parses values — it sources a real shell and reads the result, delegating all quoting, escaping, and interpolation to zsh. A bespoke dotenv parser is new, security-sensitive surface with no agreed-on dialect across tools."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Auto-discovery"}],"type":"strong"},{"type":"text","text":" (reading a "},{"code":".env","type":"codeVoice"},{"type":"text","text":" nobody configured) makes it easy to leak a secret into source control by accident and undercuts the core guarantee that only the manifest is tracked."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Want a project-local file? Use the directive above. Want machine-wide secrets every checkout and launcher sees identically? Use the default ","type":"text"},{"code":"~\/.zshenv","type":"codeVoice"},{"text":". See ","type":"text"},{"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing","isActive":true,"type":"reference"},{"text":" for why sourcing a shell beats parsing a file.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tightlipcore\/envfiledirective"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Point Tightlip at a different shell-init file with the "},{"type":"codeVoice","code":"envFile:"},{"type":"text","text":" directive."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective"},"references":{"doc://TightlipCore/documentation/TightlipCore/ConfigGrammar":{"type":"topic","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","title":"Config Grammar","url":"\/documentation\/tightlipcore\/configgrammar","abstract":[{"text":"The accepted shape of ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", line by line.","type":"text"}]},"doc://TightlipCore/documentation/TightlipCore/ContinuousIntegration":{"abstract":[{"type":"text","text":"Wire the plugin into every lane that compiles your target, and avoid the build-host trap that only shows up in simulator builds."}],"type":"topic","title":"Running Tightlip in CI","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ContinuousIntegration","url":"\/documentation\/tightlipcore\/continuousintegration"},"doc://TightlipCore/documentation/TightlipCore/SectionedConfigs":{"abstract":[{"type":"text","text":"Declare staging and production secrets in one file and select between them per build."}],"type":"topic","title":"Multi-Environment Configs","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","url":"\/documentation\/tightlipcore\/sectionedconfigs"},"doc://TightlipCore/documentation/TightlipCore":{"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"code":"Secrets","type":"codeVoice"},{"text":" enum from environment variables at build time.","type":"text"}],"url":"\/documentation\/tightlipcore","type":"topic","role":"collection","title":"Tightlip","kind":"symbol"},"doc://TightlipCore/documentation/TightlipCore/Troubleshooting":{"abstract":[{"type":"text","text":"Symptom-to-fix table for the failure modes you’ll hit integrating Tightlip."}],"role":"article","title":"Troubleshooting","kind":"article","url":"\/documentation\/tightlipcore\/troubleshooting","type":"topic","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/Troubleshooting"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSourcing":{"type":"topic","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing","title":"How Environment Sourcing Works","abstract":[{"type":"text","text":"Why your env vars resolve the same way whether you build from Xcode, the terminal, or CI."}],"url":"\/documentation\/tightlipcore\/environmentsourcing"}}}