{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"By default the build tool sources "},{"type":"codeVoice","code":"~\/.zshenv"},{"type":"text","text":" to pick up your shell-exported env vars. If your shell isn’t zsh, or your env-var exports live elsewhere, declare an "},{"type":"codeVoice","code":"envFile:"},{"type":"text","text":" directive at the top of "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The directive must be the ","type":"text"},{"inlineContent":[{"type":"text","text":"first"}],"type":"strong"},{"text":" non-blank, non-comment line. Anything after a section header or property mapping is parsed as a secret declaration and will fail.","type":"text"}],"type":"paragraph"},{"anchor":"Syntax","type":"heading","text":"Syntax","level":2},{"syntax":"yaml","type":"codeListing","code":["envFile: ~\/.bash_profile","revenueCatAPIKey: REVENUECAT_API_KEY"]},{"inlineContent":[{"type":"text","text":"The path is tilde-expanded against "},{"type":"codeVoice","code":"$HOME"},{"type":"text","text":"; relative paths resolve against the config’s directory."}],"type":"paragraph"},{"anchor":"Per-Shell-Recommendations","type":"heading","text":"Per-Shell Recommendations","level":2},{"rows":[[[{"inlineContent":[{"type":"text","text":"Shell"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Recommended path"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Notes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"zsh"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"~\/.zshenv"},{"type":"text","text":" "},{"inlineContent":[{"text":"(default — directive can be omitted)","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Sourced cleanly with ","type":"text"},{"type":"codeVoice","code":"zsh -f"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"bash","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"~\/.bash_profile"},{"type":"text","text":" or "},{"type":"codeVoice","code":"~\/.bashrc"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Sourced by zsh; shell-compatible "},{"code":"export","type":"codeVoice"},{"text":" syntax works","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"fish"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"~\/.config\/tightlip.env"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"(sidecar)"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fish syntax isn’t zsh-compatible; keep a file of ","type":"text"},{"code":"export KEY=value","type":"codeVoice"},{"text":" lines","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"nushell \/ xonsh \/ etc."}],"type":"paragraph"}],[{"inlineContent":[{"code":"~\/.tightlip.env","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"(sidecar)"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Same sidecar pattern as fish"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"CI runners typically have no "},{"code":".zshenv","type":"codeVoice"},{"type":"text","text":"; the tool falls back to "},{"code":"ProcessInfo","type":"codeVoice"},{"type":"text","text":" and the job’s "},{"code":"env:","type":"codeVoice"},{"type":"text","text":" block works unchanged."}],"type":"paragraph"}]}],"sections":[],"metadata":{"title":"Overriding the Sourced Env File","role":"article","modules":[{"name":"Tightlip"}],"roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing","doc:\/\/TightlipCore\/documentation\/TightlipCo