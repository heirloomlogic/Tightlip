{"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ContinuousIntegration","doc:\/\/TightlipCore\/documentation\/TightlipCore\/Troubleshooting"]}],"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"Tightlip"}],"role":"article","title":"Getting Started with Tightlip"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tightlipcore\/gettingstarted"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted"},"kind":"article","abstract":[{"type":"text","text":"Add the plugin to a target, drop in a "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":", and start reading secrets at compile time."}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tightlip is a SwiftPM build-tool plugin. The plugin attaches to a target, reads a "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":" config at the target’s source root, resolves declared environment variables, and emits a Swift source file containing a "},{"type":"codeVoice","code":"Secrets"},{"type":"text","text":" enum compiled into your binary."}]},{"type":"heading","text":"Installation","level":2,"anchor":"Installation"},{"type":"heading","text":"Swift Package Manager","level":3,"anchor":"Swift-Package-Manager"},{"type":"paragraph","inlineContent":[{"text":"Add the package as a dependency:","type":"text"}]},{"code":["\/\/ Package.swift",".package(url: \"https:\/\/github.com\/heirloomlogic\/Tightlip\", from: \"1.0.0\"),"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Attach the plugin to a target:","type":"text"}]},{"code":[".target(","    name: \"MyApp\",","    plugins: [.plugin(name: \"Lipservice\", package: \"Tightlip\")]",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Drop ","type":"text"},{"type":"codeVoice","code":"Secrets.yml"},{"text":" at the target’s source root, e.g. ","type":"text"},{"type":"codeVoice","code":"Sources\/MyApp\/Secrets.yml"},{"text":".","type":"text"}]},{"type":"heading","text":"Xcode project","level":3,"anchor":"Xcode-project"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"File → Add Package Dependencies…","type":"text"}]},{"type":"text","text":" → paste "},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Tightlip"},{"type":"text","text":" → set Dependency Rule to "},{"type":"strong","inlineContent":[{"type":"text","text":"Up to Next Major"}]},{"type":"text","text":" from "},{"type":"codeVoice","code":"1.0.0"},{"type":"text","text":". ("},{"type":"strong","inlineContent":[{"text":"Add Local…","type":"text"}]},{"type":"text","text":" also works for vendored checkouts.)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In the target’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Build Phases → Run Build Tool Plug-ins"}],"type":"strong"},{"text":", add ","type":"text"},{"inlineContent":[{"type":"text","text":"Lipservice"}],"type":"strong"},{"text":". The package dependency dialog lists both ","type":"text"},{"code":"Lipservice","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"LipserviceTool","type":"codeVoice"},{"text":" executable — attach ","type":"text"},{"inlineContent":[{"text":"only","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"Lipservice","type":"codeVoice"},{"text":" here, and do ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" add ","type":"text"},{"code":"LipserviceTool","type":"codeVoice"},{"text":" to the target’s ","type":"text"},{"inlineContent":[{"text":"Frameworks, Libraries, and Embedded Content","type":"text"}],"type":"emphasis"},{"text":". ","type":"text"},{"code":"LipserviceTool","type":"codeVoice"},{"text":" is the host tool the plugin runs for you; linking it into an app target builds it for the wrong platform and accomplishes nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"<TargetName>\/Secrets.yml","type":"codeVoice"},{"text":" at the project root (the directory containing ","type":"text"},{"code":".xcodeproj","type":"codeVoice"},{"text":"). ","type":"text"},{"code":"<TargetName>","type":"codeVoice"},{"text":" is the target’s ","type":"text"},{"inlineContent":[{"type":"text","text":"display name"}],"type":"emphasis"},{"text":"; the plugin resolves the path on the filesystem, not through Xcode’s group tree, so the file’s position in the Project Navigator is irrelevant. For a stock app template this is the ","type":"text"},{"code":"<TargetName>\/","type":"codeVoice"},{"text":" folder already at the top of the project.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reference the generated enum anywhere in the target: ","type":"text"},{"code":"Secrets.revenueCatAPIKey","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Your-First-Secret","text":"Your First Secret","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"yaml","code":["# Secrets.yml","revenueCatAPIKey: REVENUECAT_API_KEY"],"type":"codeListing"},{"inlineContent":[{"text":"The left side is the Swift property name; the right side names an environment variable Tightlip resolves at build time. Export the variable before building:","type":"text"}],"type":"paragraph"},{"syntax":"bash","code":["export REVENUECAT_API_KEY=\"appl_…\"","swift build"],"type":"codeListing"},{"inlineContent":[{"text":"Reference the generated enum in your code:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let client = RevenueCat(apiKey: Secrets.revenueCatAPIKey)"],"type":"codeListing"},{"inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"REVENUECAT_API_KEY"},{"text":" is unset, the build fails with a clear error pointing at the missing variable. Every declared secret is required.","type":"text"}],"type":"paragraph"},{"anchor":"What-Just-Happened","text":"What Just Happened","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"At build time Tightlip:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Parsed ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Sourced ","type":"text"},{"code":"~\/.zshenv","type":"codeVoice"},{"text":" in a clean zsh subshell and merged the result with ","type":"text"},{"code":"ProcessInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolved each declared env var to its current value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Emitted a Swift file containing a ","type":"text"},{"code":"Secrets","type":"codeVoice"},{"text":" enum, with each value XOR-encoded against a salt derived from the values themselves.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The compiler included that file in your target.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The XOR encoding defends against ","type":"text"},{"code":"strings","type":"codeVoice"},{"text":"-style extraction from the shipped binary; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/Obfuscation"},{"text":" for the threat model.","type":"text"}]}]}],"references":{"doc://TightlipCore/documentation/TightlipCore/ConfigGrammar":{"type":"topic","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","title":"Config Grammar","url":"\/documentation\/tightlipcore\/configgrammar","abstract":[{"text":"The accepted shape of ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", line by line.","type":"text"}]},"doc://TightlipCore/documentation/TightlipCore/ContinuousIntegration":{"abstract":[{"type":"text","text":"Wire the plugin into every lane that compiles your target, and avoid the build-host trap that only shows up in simulator builds."}],"type":"topic","title":"Running Tightlip in CI","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ContinuousIntegration","url":"\/documentation\/tightlipcore\/continuousintegration"},"doc://TightlipCore/documentation/TightlipCore":{"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"code":"Secrets","type":"codeVoice"},{"text":" enum from environment variables at build time.","type":"text"}],"url":"\/documentation\/tightlipcore","type":"topic","role":"collection","title":"Tightlip","kind":"symbol"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSourcing":{"type":"topic","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing","title":"How Environment Sourcing Works","abstract":[{"type":"text","text":"Why your env vars resolve the same way whether you build from Xcode, the terminal, or CI."}],"url":"\/documentation\/tightlipcore\/environmentsourcing