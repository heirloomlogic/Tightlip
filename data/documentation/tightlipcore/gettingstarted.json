{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tightlip is a SwiftPM build-tool plugin. The plugin attaches to a target, reads a "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":" config at the target’s source root, resolves declared environment variables, and emits a Swift source file containing a "},{"type":"codeVoice","code":"Secrets"},{"type":"text","text":" enum compiled into your binary."}]},{"level":2,"type":"heading","anchor":"Installation","text":"Installation"},{"level":3,"type":"heading","anchor":"Swift-Package-Manager","text":"Swift Package Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the package as a dependency:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift",".package(url: \"https:\/\/github.com\/heirloomlogic\/Tightlip\", from: \"1.0.0\"),"]},{"type":"paragraph","inlineContent":[{"text":"Attach the plugin to a target:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    plugins: [.plugin(name: \"Lipservice\", package: \"Tightlip\")]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drop "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":" at the target’s source root, e.g. "},{"type":"codeVoice","code":"Sources\/MyApp\/Secrets.yml"},{"type":"text","text":"."}]},{"level":3,"type":"heading","anchor":"Xcode-project","text":"Xcode project"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"File → Add Package Dependencies…","type":"text"}],"type":"strong"},{"type":"text","text":" → paste "},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Tightlip"},{"type":"text","text":" → set Dependency Rule to "},{"inlineContent":[{"type":"text","text":"Up to Next Major"}],"type":"strong"},{"type":"text","text":" from "},{"type":"codeVoice","code":"1.0.0"},{"type":"text","text":". ("},{"inlineContent":[{"text":"Add Local…","type":"text"}],"type":"strong"},{"type":"text","text":" also works for vendored checkouts.)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Build Phases → Run Build Tool Plug-ins"}]},{"type":"text","text":", add "},{"type":"strong","inlineContent":[{"text":"Lipservice","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"<TargetName>\/Secrets.yml"},{"type":"text","text":" at the project root (the directory containing "},{"type":"codeVoice","code":".xcodeproj"},{"type":"text","text":"). "},{"type":"codeVoice","code":"<TargetName>"},{"type":"text","text":" is the target’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"display name"}]},{"type":"text","text":"; the plugin resolves the path on the filesystem, not through Xcode’s group tree, so the file’s position in the Project Navigator is irrelevant. For a stock app template this is the "},{"type":"codeVoice","code":"<TargetName>\/"},{"type":"text","text":" folder already at the top of the project."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reference the generated enum anywhere in the target: "},{"type":"codeVoice","code":"Secrets.revenueCatAPIKey"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"level":2,"type":"heading","anchor":"Your-First-Secret","text":"Your First Secret"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"yaml","code":["# Secrets.yml","revenueCatAPIKey: REVENUECAT_API_KEY"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The left side is the Swift property name; the right side names an environment variable Tightlip resolves at build time. Export the variable before building:"}]},{"type":"codeListing","syntax":"bash","code":["export REVENUECAT_API_KEY=\"appl_…\"","swift build"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reference the generated enum in your code:"}]},{"type":"codeListing","syntax":"swift","code":["let client = RevenueCat(apiKey: Secrets.revenueCatAPIKey)"]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"REVENUECAT_API_KEY","type":"codeVoice"},{"text":" is unset, the build fails with a clear error pointing at the missing variable. Every declared secret is required.","type":"text"}]},{"level":2,"type":"heading","anchor":"What-Just-Happened","text":"What Just Happened"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At build time Tightlip:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parsed "},{"code":"Secrets.yml","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Sourced "},{"code":"~\/.zshenv","type":"codeVoice"},{"type":"text","text":" in a clean zsh subshell and merged the result with "},{"code":"ProcessInfo","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Resolved each declared env var to its current value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Emitted a Swift file containing a "},{"type":"codeVoice","code":"Secrets"},{"type":"text","text":" enum, with each value XOR-encoded against a salt derived from the values themselves."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The compiler included that file in your target.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The XOR encoding defends against "},{"type":"codeVoice","code":"strings"},{"type":"text","text":"-style extraction from the shipped binary; see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/Obfuscation"},{"type":"text","text":" for the threat model."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing"],"title":"Related Documentation","anchor":"Related-Documentation"}],"identifier":{"url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"Tightlip"}],"role":"article","title":"Getting Started with Tightlip"},"abstract":[{"type":"text","text":"Add the plugin to a target, drop in a "},{"code":"Secrets.yml","type":"codeVoice"},{"type":"text","text":", and start reading secrets at compile time."}],"kind":"article","sections":[],"variants":[{"paths":["\/documentation\/tightlipcore\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TightlipCore/documentation/TightlipCore/Obfuscation":{"title":"Obfuscation and Threat Model","url":"\/documentation\/tightlipcore\/obfuscation","type":"topic","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/Obfuscation","role":"article","kind":"article","abstract":[{"type":"text","text":"What the XOR encoding actually protects against, and what it doesn’t."}]},"doc://TightlipCore/documentation/TightlipCore/SectionedConfigs":{"role":"article","kind":"article","type":"topic","url":"\/documentation\/tightlipcore\/sectionedconfigs","abstract":[{"text":"Declare staging and production secrets in one file and select between them per build.","type":"text"}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs","title":"Multi-Environment Configs"},"doc://TightlipCore/documentation/TightlipCore":{"abstract":[{"type":"text","text":"A SwiftPM build-tool plugin that generates a typed Swift "},{"type":"codeVoice","code":"Secrets"},{"type":"text","text":" enum from environment variables at build time."}],"title":"Tightlip","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore","url":"\/documentation\/tightlipcore","type":"topic","kind":"symbol","role":"collection"},"doc://TightlipCore/documentation/TightlipCore/ConfigGrammar":{"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","title":"Config Grammar","type":"topic","abstract":[{"text":"The accepted shape of ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", line by line.","type":"text"}],"role":"article","url":"\/documentation\/tightlipcore\/configgrammar","kind":"article"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSourcing":{"title":"How Environment Sourcing Works","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSourcing","url":"\/documentation\/tightlipcore\/environmentsourcing","role":"article","type":"topic","abstract":[{"text":"Why your env vars resolve the same way whether you build from Xcode, the terminal, or CI.","type":"text"}],"kind":"article"}}}