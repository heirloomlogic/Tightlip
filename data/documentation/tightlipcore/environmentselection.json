{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"Secrets.yml"},{"type":"text","text":" declares multiple environment sections, exactly one is chosen per build. Tightlip applies these rules in order:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Selected section"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TIGHTLIP_ENV"},{"type":"text","text":" is set"}]}],[{"type":"paragraph","inlineContent":[{"text":"The section whose name matches exactly. Build fails if no section matches.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Two sections, one named ","type":"text"},{"code":"prod","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"production","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CONFIGURATION=Release","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"prod"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"production"},{"type":"text","text":" section."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Two sections, one named "},{"type":"codeVoice","code":"prod"},{"type":"text","text":" or "},{"type":"codeVoice","code":"production"},{"type":"text","text":", any other "},{"type":"codeVoice","code":"CONFIGURATION"},{"type":"text","text":" (including "},{"type":"codeVoice","code":"Debug"},{"type":"text","text":" and unset)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The non-production section."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Anything else (e.g. three sections without "},{"type":"codeVoice","code":"TIGHTLIP_ENV"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"text":"Build fails with a message listing available environments.","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Flat configs have no environment concept and ignore all of this.","type":"text"}]},{"anchor":"Recommended-Setup","type":"heading","level":2,"text":"Recommended Setup"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local dev:"}]},{"type":"text","text":" add "},{"type":"codeVoice","code":"export TIGHTLIP_ENV=staging"},{"type":"text","text":" to "},{"type":"codeVoice","code":"~\/.zshenv"},{"type":"text","text":", or leave it unset and let Debug builds pick the non-production section automatically."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"CI release lane:","type":"text"}]},{"type":"text","text":" set "},{"type":"codeVoice","code":"TIGHTLIP_ENV=production"},{"type":"text","text":", or rely on "},{"type":"codeVoice","code":"CONFIGURATION=Release"},{"type":"text","text":" if using Xcode."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"More than two environments (qa, uat, etc.):"}]},{"type":"text","text":" always set "},{"type":"codeVoice","code":"TIGHTLIP_ENV"},{"type":"text","text":" explicitly — the two-section auto-inference doesn’t fire."}],"type":"paragraph"}]}]},{"anchor":"Why-TIGHTLIPENV-Wins","type":"heading","level":2,"text":"Why `TIGHTLIP_ENV` Wins"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The explicit env var always beats "},{"type":"codeVoice","code":"CONFIGURATION"},{"type":"text","text":" inference. This lets a single CI job override the default for a one-off release-candidate build without changing the project’s Xcode scheme."}]}]}],"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","ident