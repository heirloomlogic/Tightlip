{"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"Tightlip"}],"roleHeading":"Article","role":"article","title":"Multi-Environment Configs"},"kind":"article","sections":[],"abstract":[{"text":"Declare staging and production secrets in one file and select between them per build.","type":"text"}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar"],"title":"Related Documentation"},{"anchor":"How-To-Guides","generated":true,"identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ContinuousIntegration","doc:\/\/TightlipCore\/documentation\/TightlipCore\/Troubleshooting"],"title":"How-To Guides"}],"primaryContentSections":[{"content":[{"text":"When to Use Sectioned Configs","anchor":"When-to-Use-Sectioned-Configs","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reach for sectioned configs when the same property names need different values across environments — staging keys for development builds, production keys for release builds, perhaps a "},{"type":"codeVoice","code":"qa"},{"type":"text","text":" set for a release-candidate lane."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A flat config has no environment concept. If you have one set of values, stay flat."}]},{"text":"Format","anchor":"Format","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Each top-level identifier followed by ","type":"text"},{"type":"codeVoice","code":":"},{"text":" (with no value) is an environment section. Lines within a section are indented exactly 2 spaces:","type":"text"}]},{"code":["# Secrets.yml","staging:","  revenueCatAPIKey: STAGING_REVENUECAT_API_KEY","  hmacSigningKey:   STAGING_HMAC_KEY","","production:","  revenueCatAPIKey: PROD_REVENUECAT_API_KEY","  hmacSigningKey:   PROD_HMAC_KEY"],"type":"codeListing","syntax":"yaml"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"All sections must declare the same set of property names.","type":"text"}],"type":"strong"},{"text":" Mismatched property sets fail at parse time — this prevents a release build from accidentally referencing a property that only exists in staging.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The active section is chosen at build time. For the rules — "},{"type":"codeVoice","code":"TIGHTLIP_ENV"},{"type":"text","text":", Xcode "},{"type":"codeVoice","code":"CONFIGURATION"},{"type":"text","text":", the auto-inference behavior — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"When a value is identical across environments, point the property at the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"strong"},{"text":" env var in every section. That’s valid — the developer exports one variable, and the resolved section still picks it up. Only the values that genuinely differ need per-environment variables.","type":"text"}]},{"text":"Naming Convention for Env Vars","anchor":"Naming-Convention-for-Env-Vars","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Devs working on several apps on the same machine see bare names like ","type":"text"},{"code":"REVENUECAT_API_KEY","type":"codeVoice"},{"text":" collide. Prefix every env var with an app-specific tag — ","type":"text"},{"code":"<APP_PREFIX>_<SECRET>","type":"codeVoice"},{"text":" in screaming snake case (e.g. ","type":"text"},{"code":"ACME_REVENUECAT_API_KEY","type":"codeVoice"},{"text":"). Tightlip doesn’t enforce this; the convention just keeps configs across projects from stepping on each other.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Swift-side property name (","type":"text"},{"code":"revenueCatAPIKey","type":"codeVoice"},{"text":") stays clean either way — only the env-var side gets the prefix.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tightlipcore\/sectionedconfigs"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TightlipCore/documentation/TightlipCore/Troubleshooting":{"abstract":[{"type":"text","text":"Symptom-to-fix table for the failure modes you’ll hit integrating Tightlip."}],"role":"article","title":"Troubleshooting","kind":"article","url":"\/documentation\/tightlipcore\/troubleshooting","type":"topic","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/Troubleshooting"},"doc://TightlipCore/documentation/TightlipCore":{"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"code":"Secrets","type":"codeVoice"},{"text":" enum from environment variables at build time.","type":"text"}],"url":"\/documentation\/tightlipcore","type":"topic","role":"collection","title":"Tightlip","kind":"symbol"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSelection":{"role":"article","type":"topic","url":"\/documentation\/tightlipcore\/environmentselection","title":"Environment Selection","abstract":[{"type":"text","text":"How Tightlip picks the active section for a sectioned config."}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","kind":"article"},"doc://TightlipCore/documentation/TightlipCore/ConfigGrammar":{"type":"topic","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar","title":"Config Grammar","url":"\/documentation\/tightlipcore\/configgrammar","abstract":[{"text":"The accepted shape of ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", line by line.","type":"text"}]},"doc://TightlipCore/documentation/TightlipCore/ContinuousIntegration":{"abstract":[{"type":"text","text":"Wire the plugin into every lane that compiles your target, and avoid the build-host trap that only shows up in simulator builds."}],"type":"topic","title":"Running Tightlip in CI","kind":"article","role":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ContinuousIntegration","url":"\/documentation\/tightlipcore\/continuousintegration"},"doc://TightlipCore/documentation/TightlipCore/EnvFileDirective":{"kind":"article","title":"Overriding the Sourced Env File","url":"\/documentation\/tightlipcore\/envfiledirective","type":"topic","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective","abstract":[{"text":"Point Tightlip at a different shell-init file with the ","type":"text"},{"code":"envFile:","type":"codeVoice"},{"text":" directive.","type":"text"}],"role":"article"}}}