{"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar"],"title":"Related Documentation"},{"anchor":"How-To-Guides","identifiers":["doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective"],"title":"How-To Guides","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tightlipcore\/sectionedconfigs"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/SectionedConfigs"},"sections":[],"kind":"article","metadata":{"title":"Multi-Environment Configs","roleHeading":"Article","role":"article","modules":[{"name":"Tightlip"}]},"hierarchy":{"paths":[["doc:\/\/TightlipCore\/documentation\/TightlipCore"]]},"abstract":[{"type":"text","text":"Declare staging and production secrets in one file and select between them per build."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"When-to-Use-Sectioned-Configs","text":"When to Use Sectioned Configs"},{"inlineContent":[{"text":"Reach for sectioned configs when the same property names need different values across environments — staging keys for development builds, production keys for release builds, perhaps a ","type":"text"},{"type":"codeVoice","code":"qa"},{"text":" set for a release-candidate lane.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A flat config has no environment concept. If you have one set of values, stay flat."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Format","text":"Format"},{"inlineContent":[{"text":"Each top-level identifier followed by ","type":"text"},{"type":"codeVoice","code":":"},{"text":" (with no value) is an environment section. Lines within a section are indented exactly 2 spaces:","type":"text"}],"type":"paragraph"},{"code":["# Secrets.yml","staging:","  revenueCatAPIKey: STAGING_REVENUECAT_API_KEY","  hmacSigningKey:   STAGING_HMAC_KEY","","production:","  revenueCatAPIKey: PROD_REVENUECAT_API_KEY","  hmacSigningKey:   PROD_HMAC_KEY"],"syntax":"yaml","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"All sections must declare the same set of property names.","type":"text"}]},{"type":"text","text":" Mismatched property sets fail at parse time — this prevents a release build from accidentally referencing a property that only exists in staging."}],"type":"paragraph"},{"inlineContent":[{"text":"The active section is chosen at build time. For the rules — ","type":"text"},{"code":"TIGHTLIP_ENV","type":"codeVoice"},{"text":", Xcode ","type":"text"},{"code":"CONFIGURATION","type":"codeVoice"},{"text":", the auto-inference behavior — see ","type":"text"},{"type":"reference","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Naming-Convention-for-Env-Vars","text":"Naming Convention for Env Vars"},{"inlineContent":[{"type":"text","text":"Devs working on several apps on the same machine see bare names like "},{"type":"codeVoice","code":"REVENUECAT_API_KEY"},{"type":"text","text":" collide. Prefix every env var with an app-specific tag — "},{"type":"codeVoice","code":"<APP_PREFIX>_<SECRET>"},{"type":"text","text":" in screaming snake case (e.g. "},{"type":"codeVoice","code":"ACME_REVENUECAT_API_KEY"},{"type":"text","text":"). Tightlip doesn’t enforce this; the convention just keeps configs across projects from stepping on each other."}],"type":"paragraph"},{"inlineContent":[{"text":"The Swift-side property name (","type":"text"},{"code":"revenueCatAPIKey","type":"codeVoice"},{"text":") stays clean either way — only the env-var side gets the prefix.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://TightlipCore/documentation/TightlipCore/ConfigGrammar":{"title":"Config Grammar","kind":"article","type":"topic","role":"article","url":"\/documentation\/tightlipcore\/configgrammar","abstract":[{"text":"The accepted shape of ","type":"text"},{"code":"Secrets.yml","type":"codeVoice"},{"text":", line by line.","type":"text"}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/ConfigGrammar"},"doc://TightlipCore/documentation/TightlipCore/EnvironmentSelection":{"abstract":[{"type":"text","text":"How Tightlip picks the active section for a sectioned config."}],"url":"\/documentation\/tightlipcore\/environmentselection","title":"Environment Selection","kind":"article","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvironmentSelection","role":"article","type":"topic"},"doc://TightlipCore/documentation/TightlipCore/EnvFileDirective":{"title":"Overriding the Sourced Env File","kind":"article","type":"topic","role":"article","url":"\/documentation\/tightlipcore\/envfiledirective","abstract":[{"type":"text","text":"Point Tightlip at a different shell-init file with the "},{"type":"codeVoice","code":"envFile:"},{"type":"text","text":" directive."}],"identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore\/EnvFileDirective"},"doc://TightlipCore/documentation/TightlipCore":{"title":"Tightlip","type":"topic","kind":"symbol","identifier":"doc:\/\/TightlipCore\/documentation\/TightlipCore","url":"\/documentation\/tightlipcore","role":"collection","abstract":[{"text":"A SwiftPM build-tool plugin that generates a typed Swift ","type":"text"},{"type":"codeVoice","code":"Secrets"},{"text":" enum from environment variables at build time.","type":"text"}]}}}